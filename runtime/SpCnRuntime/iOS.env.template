# ─────────────────────────────────────────────────────────────────────────────
# SpCn iOS 单机内嵌运行时 —— 环境模板（契约 v1 / EMBEDDED_RUNTIME=1）
#
# 这份模板**只是参考与文档**：真机运行时由 tweak 的 Supervisor 自己拼环境变量
# （它要按当前可写目录动态决定 DATA_DIR / 端口 / 原生模块绝对路径），不读这个文件。
# 用途：① 记录"单机离线"这套值到底长什么样；② 在 Mac / WSL 上手工复现同一套配置排障。
#
# 关键约束（来自 docs/embedded-runtime-contract.md）：
#   · 所有路径必须是**绝对路径**；DATA_DIR 不得与 server-bundle / CDN 目录相同或嵌套。
#   · 嵌入式模式禁用 WDFP_DATABASE_DIR / CONTENT_DIR / CONTENT_STORE_DIR /
#     CONTENT_STATE_DIR / CONTENT_RUNTIME_DIR 这批老变量。
#   · 原生模块用 .so/.node 时，服务端会先 process.dlopen() 再把 exports 交给 better-sqlite3。
# ─────────────────────────────────────────────────────────────────────────────

EMBEDDED_RUNTIME=1

# ── 数据卷（唯一可写目录；由 Supervisor 覆盖成设备上的真实路径）──
#   jailbreak : /var/mobile/Library/SpCn/data
#   非越狱侧载 : <App 容器>/Documents/SpCn/data
DATA_DIR=/var/mobile/Library/SpCn/data

# ── 监听：单机 = 全部只绑回环，不出网 ──
CN_LISTEN_HOST=127.0.0.1
CN_LISTEN_PORT=8001
SESSION_HOST=127.0.0.1
SESSION_PORT=8003
MULTI_HUB_PORT=8004
# 联机房间响应里告诉客户端的地址（单机也是回环）
SESSION_PUBLIC_HOST=127.0.0.1

# ── 资源模式：单机 = 客户端自带资源，服务端不做内容同步、不提供 CDN 下载 ──
ASSET_MODE=client-owned
CDN_BASE_URL=http://127.0.0.1:8001/patch/cn

# ── iOS 兼容层：客户端请求 /shijtswy/version/client_release_ios.dis 时必须由我们接管 ──
IOS_COMPAT_ENABLED=1
IOS_API_HOST=127.0.0.1:8001
IOS_API_SCHEME=http
# SDK Bean 的 AES 参数与每设备身份密钥（与已交付服务端一致；缺 IOS_SDK_IDENTITY_SECRET 时
# SDK 登录会 fail-closed，本机探针里能看到这条 warn）
IOS_SDK_BEAN_KEY=#LeitingAESKey#!
IOS_SDK_BEAN_IV=LeitingAESIVKEY!
IOS_SDK_IDENTITY_SECRET=wfcn-ios-sdk-identity-2026-10-01-8f3a91c4d2e6b705

# ── 后台：留空 = 只允许回环地址访问（单机场景正好；悬浮窗里的 WKWebView 也是回环）──
ADMIN_PASSWORD=

# ── 绑定闸门：单机不需要 QQ/KOOK 绑定 ──
BIND_GATE_ENABLED=0

# ── 原生模块绝对路径（Supervisor 会覆盖；这里写设备上的期望值）──
BETTER_SQLITE3_NATIVE_BINDING=/var/mobile/Library/SpCn/runtime/node_modules/better-sqlite3/build/Release/better_sqlite3.node

# ── 诊断 ──
SP_PROBE_UDID=0
# 需要抓 SDK 真实请求行时打开（落到 DATA_DIR 下）
# IOS_NOTICE_PROBE=1
